{
    "tasks": [
        {
            "type": "process",
            "label": "C/C++: build active file",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\build-active-file.ps1",
                "-SourceFile",
                "${file}",
                "-WorkspaceFolder",
                "${workspaceFolder}",
                "-CompilerPath",
                "C:\\mingw64\\bin\\g++.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the active C++ project within the workspace"
        }
    ],
    "version": "2.0.0"
}